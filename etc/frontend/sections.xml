<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Customer:etc/sections.xsd">
    <action name="checkout/cart/add">
        <section name="ineiman_tiktok_add_to_cart"/>
    </action>
    <action name="checkout/cart/updatePost">
        <section name="ineiman_tiktok_update_cart"/>
    </action>
    <action name="checkout/cart/delete">
        <section name="ineiman_tiktok_remove_from_cart"/>
    </action>
    <action name="checkout/sidebar/removeItem">
        <section name="ineiman_tiktok_remove_from_cart"/>
    </action>
    <action name="checkout/sidebar/updateItemQty">
        <section name="ineiman_tiktok_update_cart"/>
    </action>
    <action name="wishlist/index/add">
        <section name="ineiman_tiktok_add_to_wishlist"/>
    </action>
    <action name="customer/account/createPost">
        <section name="ineiman_tiktok_complete_registration"/>
    </action>
    <action name="rest/*/V1/carts/*/payment-information">
        <section name="ineiman_tiktok_add_payment_info"/>
    </action>
    <action name="rest/*/V1/guest-carts/*/payment-information">
        <section name="ineiman_tiktok_add_payment_info"/>
    </action>
    <action name="rest/*/V1/carts/*/set-payment-information">
        <section name="ineiman_tiktok_add_payment_info"/>
    </action>
    <action name="rest/*/V1/guest-carts/*/set-payment-information">
        <section name="ineiman_tiktok_add_payment_info"/>
    </action>
    <action name="rest/*/V1/carts/*/selected-payment-method">
        <section name="ineiman_tiktok_add_payment_info"/>
    </action>
    <action name="rest/*/V1/guest-carts/*/selected-payment-method">
        <section name="ineiman_tiktok_add_payment_info"/>
    </action>
</config>
