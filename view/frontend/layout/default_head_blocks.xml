<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <referenceBlock name="head.additional">
        <block ifconfig="tiktok/general/enabled" class="Magento\Framework\View\Element\Template" name="tiktok.main" template="Ineiman_TikTok::main.phtml">
            <block ifconfig="tiktok/frontend_events/enabled" class="Ineiman\TikTok\Block\Track\Tiktok" name="tiktok.main.script" template="Ineiman_TikTok::script-tiktok.phtml">
                <block ifconfig="tiktok/frontend_events/add_to_cart_enabled" class="Magento\Framework\View\Element\Template" name="tiktok.track.add.to.cart" template="Ineiman_TikTok::track/tiktok/events-section-tracking.phtml">
                    <arguments>
                        <argument name="event_name" xsi:type="const">Ineiman\TikTok\Api\Data\TikTokInterface::EVENT_NAME_ADD_TO_CART</argument>
                        <argument name="event_section_name" xsi:type="const">Ineiman\TikTok\Api\Data\TikTokInterface::EVENT_KEY_ADD_TO_CART</argument>
                    </arguments>
                </block>
                <block ifconfig="tiktok/frontend_events/update_cart_enabled" class="Magento\Framework\View\Element\Template" name="tiktok.track.update.cart" template="Ineiman_TikTok::track/tiktok/events-section-tracking.phtml">
                    <arguments>
                        <argument name="event_name" xsi:type="const">Ineiman\TikTok\Api\Data\TikTokInterface::EVENT_NAME_UPDATE_CART</argument>
                        <argument name="event_section_name" xsi:type="const">Ineiman\TikTok\Api\Data\TikTokInterface::EVENT_KEY_UPDATE_CART</argument>
                    </arguments>
                </block>
                <block ifconfig="tiktok/frontend_events/remove_from_cart_enabled" class="Magento\Framework\View\Element\Template" name="tiktok.track.remove.from.cart" template="Ineiman_TikTok::track/tiktok/events-section-tracking.phtml">
                    <arguments>
                        <argument name="event_name" xsi:type="const">Ineiman\TikTok\Api\Data\TikTokInterface::EVENT_NAME_REMOVE_FROM_CART</argument>
                        <argument name="event_section_name" xsi:type="const">Ineiman\TikTok\Api\Data\TikTokInterface::EVENT_KEY_REMOVE_FROM_CART</argument>
                    </arguments>
                </block>
                <block ifconfig="tiktok/frontend_events/add_to_wishlist_enabled" class="Magento\Framework\View\Element\Template" name="tiktok.track.add.to.wishlist" template="Ineiman_TikTok::track/tiktok/events-section-tracking.phtml">
                    <arguments>
                        <argument name="event_name" xsi:type="const">Ineiman\TikTok\Api\Data\TikTokInterface::EVENT_NAME_ADD_TO_WISHLIST</argument>
                        <argument name="event_section_name" xsi:type="const">Ineiman\TikTok\Api\Data\TikTokInterface::EVENT_KEY_ADD_TO_WISHLIST</argument>
                    </arguments>
                </block>
                <block ifconfig="tiktok/frontend_events/complete_registration_enabled" class="Magento\Framework\View\Element\Template" name="tiktok.track.customer.complete.registration" template="Ineiman_TikTok::track/tiktok/events-section-tracking.phtml">
                    <arguments>
                        <argument name="event_name" xsi:type="const">Ineiman\TikTok\Api\Data\TikTokInterface::EVENT_NAME_COMPLETE_REGISTRATION</argument>
                        <argument name="event_section_name" xsi:type="const">Ineiman\TikTok\Api\Data\TikTokInterface::EVENT_KEY_COMPLETE_REGISTRATION</argument>
                    </arguments>
                </block>
            </block>
        </block>
    </referenceBlock>
</page>
