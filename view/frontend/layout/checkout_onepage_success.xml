<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <referenceContainer name="content">
        <block ifconfig="tiktok/general/enabled" class="Magento\Framework\View\Element\Template" name="tiktok.track.checkout.main" template="Ineiman_TikTok::main.phtml">
            <block ifconfig="tiktok/frontend_events/enabled" class="Magento\Framework\View\Element\Template" name="tiktok.track.checkout.main.frontend" template="Ineiman_TikTok::main.phtml">
                <block ifconfig="tiktok/frontend_events/place_an_order_enabled" class="Magento\Framework\View\Element\Template" name="tiktok.track.checkout.place.an.order" template="Ineiman_TikTok::track/tiktok/events-direct-tracking.phtml">
                    <arguments>
                        <argument name="payload" xsi:type="helper" helper="Ineiman\TikTok\Api\TiktokManagementInterface::getPlaceAnOrderEventPayload" />
                    </arguments>
                </block>
            </block>
        </block>
    </referenceContainer>
</page>
